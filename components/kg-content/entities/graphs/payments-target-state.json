  "schema_version": "0.1-experimental",
  "id": "payments-target-state",
  "type": "graph",
  "title": "Payments Target State",
  "description": "Tyro's target-state payment flow, end to end: designing a product, onboarding a merchant onto it, then taking payments and getting paid. It shows which domains, systems and people take part at each step, and what each hand-off between them carries.",
  "status": "draft",
  "owner": "architecture-practice",
  "updated": "2026-09-29",
  "source": "https://tyropaymentsltd.atlassian.net/wiki/spaces/ARCH/whiteboard/1823277126",
  "provenance": "curated-here",
  "source_notes": "This file is the source of truth, iterated on directly in git (decision 61 in docs/decision-log.md, 2026-09-29); the Confluence originals are not re-synced. Originally derived from the structured text feed the whiteboard's owner authored for this purpose (https://tyropaymentsltd.atlassian.net/wiki/spaces/ARCH/pages/2382233611/Payment+target+state+WIP+AI+feed), because the whiteboard body is not readable through the Atlassian connector. Divergences since then are recorded in docs/decision-log.md, starting with decision 60: the actor 'Customer (self-serve / merchant)' renamed 'Merchant', and the edge 'Cross-domain reports CONSUMED_BY Customer (Merchant portal insights)' removed.",
  "stages": [
    {
      "id": "design-a-product",
      "ordinal": 1,
      "title": "Design a Product",
      "boundary": "design-time",
      "purpose": "Define and govern canonical product specifications, pricing models, feature policies and bundling rules before any customer or terminal interaction."
    },
    {
      "id": "customer-product-onboarding",
      "ordinal": 2,
      "title": "Customer / Product Onboarding",
      "boundary": "runtime",
      "purpose": "Convert prospect intent into configured merchant records, provision terminal hardware and SDKs, and distribute customer configuration intent into runtime domains."
    },
    {
      "id": "taking-payments-and-getting-paid",
      "ordinal": 3,
      "title": "Taking Payments and Getting Paid",
      "boundary": "runtime",
      "purpose": "Ingest payments across touchpoints, clear and authorise against schemes, project ledger accounting, calculate settlements, execute funds movement, recover fees, and feed analytics."
    }
  ],
